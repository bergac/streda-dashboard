# Copy this file to .env and adjust. Docker Compose reads .env automatically.

# IP address of the Streda control box on your home network.
STREDA_HOST=123.456.7.8
# MQTT port of the box (Zigbee2MQTT). Leave as is unless you know otherwise.
STREDA_MQTT_PORT=9999
# Only if the box asks for a login (by default it doesn't).
STREDA_MQTT_USERNAME=
STREDA_MQTT_PASSWORD=
STREDA_BASE_TOPIC=zigbee2mqtt

# Database password. Use letters and digits only (it goes into a URL).
POSTGRES_PASSWORD=change-me-letters-and-digits

# Port for the dashboard on this computer: http://localhost:8080
DASHBOARD_PORT=8080
TZ=Europe/Amsterdam

# Used to estimate power for units that only report current (amps).
MAINS_VOLTAGE=230
# How long to keep raw messages from the box (days, 0 = forever).
RAW_RETENTION_DAYS=7
# How long to keep value history (days, 0 = forever).
READINGS_RETENTION_DAYS=0
